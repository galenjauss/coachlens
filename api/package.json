{
  "name": "@matside/api",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx src/db/seed-cli.ts",
    "eval": "tsx evals/run-router.ts",
    "dev": "tsx watch src/dev-server.ts",
    "build": "esbuild src/index.ts --bundle --minify --platform=node --format=esm --outfile=api/index.mjs --banner:js=\"import{createRequire as __cr}from'module';globalThis.require??=__cr(import.meta.url);\" --alias:@matside/shared=../shared/src/index.ts && mkdir -p public && echo ok > public/index.txt"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@matside/shared": "*",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/functions": "^3.0.0",
    "ai": "^7.0.143",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "openai": "^7.37.0",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@hono/node-server": "^2.1.5",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
